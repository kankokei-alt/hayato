{
  "name": "hayato",
  "version": "0.1.0",
  "private": true,
  "description": "iPhoneだけで音声会話できるAIエージェント「ハヤト」",
  "type": "module",
  "scripts": {
    "build": "esbuild src/agent.ts --bundle --format=esm --target=safari16 --minify --legal-comments=linked --outfile=docs/agent.js",
    "typecheck": "tsc --noEmit",
    "serve": "npx --yes http-server docs -p 8080 -c-1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
