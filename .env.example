# ===== 必須 =====
# Claude API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# スマホのアプリの設定画面で同じ値を入力する。念のため必ず設定しておく
HAYATO_PASSCODE=

# ===== 任意 =====
PORT=3000
# 未指定ならこのPCの中（127.0.0.1 と ::1）だけで待ち受ける。スマホからは Tailscale 経由でつなぐので外に開く必要はない
# HOST=127.0.0.1
# キャラクターの名前と、あなたの呼び方
HAYATO_NAME=ハヤト
HAYATO_USER_CALL_NAME=あなた
# 予定や日時の基準になるタイムゾーン
HAYATO_TIMEZONE=Asia/Tokyo
# 使うモデルと思考の深さ（low / medium / high）。low が最も速く、会話向き
HAYATO_MODEL=claude-opus-5-5
HAYATO_EFFORT=low

# ===== Googleカレンダー連携（使う場合のみ） =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Googleへのログインは PC のブラウザ（localhost）で行うので、このままでよい
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
