# ===== 必須 =====
# Claude API キー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# スマホから使う（インターネットに公開する）なら必ず設定。アプリの設定画面で同じ値を入力する
HAYATO_PASSCODE=

# ===== 任意 =====
PORT=3000
# キャラクターの名前と、あなたの呼び方
HAYATO_NAME=ハヤト
HAYATO_USER_CALL_NAME=あなた
# 予定や日時の基準になるタイムゾーン
HAYATO_TIMEZONE=Asia/Tokyo
# 使うモデルと思考の深さ（low / medium / high）。low が最も速く、会話向き
HAYATO_MODEL=claude-opus-5-5
HAYATO_EFFORT=low

# ===== Googleカレンダー連携（使う場合のみ） =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 公開URLで使う場合は https://<あなたのドメイン>/auth/google/callback に変更し、Google側にも同じURLを登録
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
